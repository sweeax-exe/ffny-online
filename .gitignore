# ---- NEVER commit game data: the user supplies their own dump ----
*.iso
*.xiso
*.xiso.iso
*.xbe
*.7z
*.zip
*.rar
private/
src/recomp/gen/**
src/recomp/gen-pending-*/
!src/recomp/gen/.gitkeep
game/assets/
assets/
extracted/

# ---- build output ----
build/
out/
cmake-build-*/
*.obj
*.o
*.pdb
*.ilk
*.exe
*.dll
*.so
*.a
*.lib

# ---- editors / OS ----
.vs/
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store

# ---- python ----
__pycache__/
*.pyc
.venv/

# ---- local junction to the extracted disc (never committed) ----
/game/
# the same name as a symlink, which is how the folder is linked off Windows
/game

# ---- runtime logs ----
logs/
*.log

# ---- local development history (not part of the published tree) ----
/docs/worklog/

# ---- rendered frames are game artwork; captures stay local ----
*.bmp
*.ppm
tests/golden/*.png

# ---- the website build (website/build.py copies the approved pictures in) ----
website/dist/
# ---- personal agent settings (the shared .claude/skills, .claude/agents, .codex/skills are generated and tracked) ----
.claude/settings.local.json
CLAUDE.local.md

# Mod manager local verification state
/mod-manager/
/mods/
/data/

# Private authoring data stays outside source even when stored near a worktree.
/authoring/
/workspaces/
/candidates/
*.local.json
*.local.md
/config/menu-ui-*.json

# The server (relay, account service, Discord bot) lives in the private repository
# sweeax-exe/ffny-server, cloned here as server/.
/server/
